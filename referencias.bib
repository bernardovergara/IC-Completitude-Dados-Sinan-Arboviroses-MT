@article{chiavegattofilhoUsoBigData2015,
	title = {Uso de big data em saúde no {Brasil}: perspectivas para um futuro próximo},
	volume = {24},
	issn = {1679-4974},
	shorttitle = {Uso de big data em saúde no {Brasil}},
	url = {http://www.iec.pa.gov.br/template_doi_ess.php?doi=10.5123/S1679-49742015000200015&scielo=S2237-96222015000200325},
	doi = {10.5123/s1679-49742015000200015},
	abstract = {The use of big data has increased in recent years in all scientific areas. There are currently three promising areas for the use of big data in healthcare: precision medicine, electronic medical records and the internet of things. Two programming languages have gained momentum in data science: R and Python. Regarding the statistical techniques, it is expected that machine learning (especially classification and regression trees), methodologies for controlling spurious associations (such as Bonferroni correction and false discovery rate) and methodologies for dimension reduction (such as principal components analysis and propensity scores) will be increasingly used. Privacy is an issue that will become ever more important in data analysis. The use of big data in healthcare will bring enormous gains in terms of costs, time and lives saved, and needs to be actively defended by data scientists and epidemiologists.},
	language = {pt},
	number = {2},
	urldate = {2025-05-22},
	journal = {Epidemiologia e Serviços de Saúde},
	publisher = {FapUNIFESP (SciELO)},
	author = {Chiavegatto Filho, Alexandre Dias Porto},
	month = jun,
	year = {2015},
	pages = {325--332},
	file = {Chiavegatto Filho - 2015 - Uso de big data em saúde no Brasil perspectivas para um futuro próximo.pdf:G\:\\Other computers\\My Laptop\\Bibliografia\\Chiavegatto Filho - 2015 - Uso de big data em saúde no Brasil perspectivas para um futuro próximo.pdf:application/pdf},
}

@article{marquesAvaliacaoNaoCompletude2020,
	title = {Avaliação da não completude das notificações compulsórias de dengue registradas por município de pequeno porte no {Brasil}},
	volume = {25},
	issn = {1413-8123, 1413-8123, 1678-4561},
	url = {https://www.scielosp.org/article/csc/2020.v25n3/891-900/},
	doi = {10.1590/1413-81232020253.16162018},
	abstract = {Resumo O objetivo deste artigo é analisar a completude dos campos de notificações de dengue registradas em um município de pequeno porte no Brasil, no período de 2007 a 2015. Estudo descritivo com abordagem quantitativa, composto pela totalidade de registros disponíveis no Sistema Nacional de Agravos de Notificação. Analisou-se o número absoluto e o percentual de não preenchimento das variáveis chave, obrigatórias e essenciais das fichas de notificação de dengue e com a finalidade de avaliar os graus de não completude, adotou-se escore proposto por Romero e Cunha. Foi calculado o coeficiente não paramétrico de correlação linear de Spearman (rs), sendo precedido pela verificação da distribuição dos dados através do teste de Kolmogorov Smirnov. A proporção de informações ignoradas foi elevada para a maioria das variáveis e para algumas, as tendências de não completude no decorrer dos anos foram decrescentes e estatisticamente significantes. A qualidade dos dados foi, em sua maioria, classificada como regular e muito ruim, tornando-se imprescindível o estabelecimento de estratégias no processo de capacitação das equipes de saúde que atuam na atenção primária, para a sensibilização e conscientização da importância da qualidade no registro das notificações compulsórias.},
	language = {pt},
	urldate = {2025-11-22},
	journal = {Ciência \& Saúde Coletiva},
	publisher = {ABRASCO - Associação Brasileira de Saúde Coletiva},
	author = {Marques, Carla Adriana and Siqueira, Marluce Mechelli de and Portugal, Flávia Batista},
	month = mar,
	year = {2020},
	keywords = {Dengue, Notificação compulsória, Vigilância epidemiológica, Sistema de Informação em Saúde},
	pages = {891--900},
	file = {Marques et al. - 2020 - Avaliação da não completude das notificações compulsórias de dengue registradas por município de peq 2.pdf:G\:\\Other computers\\My Laptop\\Bibliografia\\Marques et al. - 2020 - Avaliação da não completude das notificações compulsórias de dengue registradas por município de peq 2.pdf:application/pdf},
}

